# Environment Variables Configuration

# Hugging Face Access Token (Free at https://huggingface.co/settings/tokens)
# When set, activates OpenAI CLIP ViT-B/32 zero-shot gating for Stage 1 with 0 MB server RAM overhead.
# If omitted, Stage 1 seamlessly uses the local ResNet-50 classifier.
HF_TOKEN=

# Stage 1 Mode: "auto" (default, uses CLIP if token present, else ResNet-50), "clip", or "resnet"
STAGE1_MODE=auto

# Gemini API Key for Help Desk Chatbot
GEMINI_API_KEY=

# Optional Admin Token for /api/memory/list and feedback export
ADMIN_TOKEN=
